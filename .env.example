# Generated automatically by scripts/bootstrap.sh in normal use.
# Keep runtime data on the WSL/Linux filesystem, outside the repository.
KARVE_DATA_ROOT=/home/your-user/karve-data

# Used to align the container user with the WSL user for bind-mounted files.
LOCAL_UID=1000
LOCAL_GID=1000

# P4 uses a host-network Compose override so the trusted local Karve CLI can
# reach the existing Bifrost gateway while Bifrost stays bound to WSL localhost.
BIFROST_BASE_URL=http://127.0.0.1:10020

# Leave empty while the local gateway requires no inference auth. If auth is
# enabled later, set this only in the local environment/.env; never commit it.
BIFROST_AUTH_TOKEN=
