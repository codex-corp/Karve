{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://karve.local/schemas/edit-plan-v1.schema.json",
  "title": "Karve Edit Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "source_duration_seconds",
    "summary",
    "decisions",
    "visual_intents"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [1]
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "source_duration_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "start",
          "end",
          "reason_code",
          "reason",
          "confidence",
          "evidence_segment_ids"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": ["keep", "remove"]
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "reason_code": {
            "type": "string",
            "enum": [
              "speech",
              "silence",
              "false_start",
              "repeated_take",
              "filler",
              "mistake",
              "off_topic",
              "transition",
              "uncertain_asr",
              "other"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_segment_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "visual_intents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "start",
          "end",
          "reason",
          "confidence",
          "intensity",
          "text"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "punch_in",
              "caption_emphasis",
              "title",
              "callout",
              "explainer"
            ]
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "intensity": {
            "type": "string",
            "enum": ["subtle", "normal", "strong"]
          },
          "text": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    }
  }
}
