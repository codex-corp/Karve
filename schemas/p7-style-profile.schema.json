{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://karve.local/schemas/p7-style-profile-v1.schema.json",
  "title": "Karve P7 Style Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "description",
    "typography",
    "colors",
    "spacing",
    "radius",
    "stroke",
    "host_pip",
    "motion",
    "safe_areas"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "const": 1 },
    "description": { "type": "string", "minLength": 1 },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["font_family_arabic", "font_family_latin", "font_family_code", "scale", "weights", "line_heights"],
      "properties": {
        "font_family_arabic": { "type": "string", "minLength": 1 },
        "font_family_latin": { "type": "string", "minLength": 1 },
        "font_family_code": { "type": "string", "minLength": 1 },
        "scale": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "headline", "subhead", "body", "caption", "micro"],
          "properties": {
            "title": { "type": "number", "minimum": 1 },
            "headline": { "type": "number", "minimum": 1 },
            "subhead": { "type": "number", "minimum": 1 },
            "body": { "type": "number", "minimum": 1 },
            "caption": { "type": "number", "minimum": 1 },
            "micro": { "type": "number", "minimum": 1 }
          }
        },
        "weights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["regular", "medium", "bold"],
          "properties": {
            "regular": { "type": "integer", "minimum": 100, "maximum": 900 },
            "medium": { "type": "integer", "minimum": 100, "maximum": 900 },
            "bold": { "type": "integer", "minimum": 100, "maximum": 900 }
          }
        },
        "line_heights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tight", "normal", "relaxed"],
          "properties": {
            "tight": { "type": "number", "exclusiveMinimum": 0 },
            "normal": { "type": "number", "exclusiveMinimum": 0 },
            "relaxed": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background",
        "canvas_dark",
        "card_surface",
        "card_surface_elevated",
        "card_border",
        "text_primary",
        "text_secondary",
        "text_muted",
        "accent_primary",
        "accent_secondary",
        "accent_highlight",
        "danger"
      ],
      "properties": {
        "background": { "type": "string" },
        "canvas_dark": { "type": "string" },
        "card_surface": { "type": "string" },
        "card_surface_elevated": { "type": "string" },
        "card_border": { "type": "string" },
        "text_primary": { "type": "string" },
        "text_secondary": { "type": "string" },
        "text_muted": { "type": "string" },
        "accent_primary": { "type": "string" },
        "accent_secondary": { "type": "string" },
        "accent_highlight": { "type": "string" },
        "danger": { "type": "string" }
      }
    },
    "spacing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "padding_card", "gap_elements", "margin_section"],
      "properties": {
        "unit": { "type": "number", "exclusiveMinimum": 0 },
        "padding_card": { "type": "number", "exclusiveMinimum": 0 },
        "gap_elements": { "type": "number", "exclusiveMinimum": 0 },
        "margin_section": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "radius": {
      "type": "object",
      "additionalProperties": false,
      "required": ["card", "badge", "pip"],
      "properties": {
        "card": { "type": "number", "minimum": 0 },
        "badge": { "type": "number", "minimum": 0 },
        "pip": { "type": "number", "minimum": 0 }
      }
    },
    "stroke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diagram_line", "card_border", "emphasis_halo"],
      "properties": {
        "diagram_line": { "type": "number", "exclusiveMinimum": 0 },
        "card_border": { "type": "number", "exclusiveMinimum": 0 },
        "emphasis_halo": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "host_pip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aspect_ratio", "width_px", "height_px", "border_width", "border_color", "shadow", "corner_radius"],
      "properties": {
        "aspect_ratio": { "const": "16:9" },
        "width_px": { "type": "number", "exclusiveMinimum": 0 },
        "height_px": { "type": "number", "exclusiveMinimum": 0 },
        "border_width": { "type": "number", "minimum": 0 },
        "border_color": { "type": "string" },
        "shadow": { "type": "string" },
        "corner_radius": { "type": "number", "minimum": 0 }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transition_fast_seconds", "transition_normal_seconds", "transition_slow_seconds", "easing"],
      "properties": {
        "transition_fast_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "transition_normal_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "transition_slow_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "easing": { "type": "string" }
      }
    },
    "safe_areas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caption_bottom_margin_px", "host_exclusion_margin_px"],
      "properties": {
        "caption_bottom_margin_px": { "type": "number", "minimum": 0 },
        "host_exclusion_margin_px": { "type": "number", "minimum": 0 }
      }
    }
  }
}
